# This exact protocol is hashed into local radiometric evidence on Windows/Linux.
configs/radiometry-protocol.json text eol=lf
web/** text eol=lf
web/data/** -text
web/regions/** -text
docs/images/*.png binary
.github/** text eol=lf
# Evidence hashes identify exact acquisition/output bytes across checkouts.
docs/evidencias/** -text
data/regions/selection/** -text
# ASCII-encoded PDF streams still require byte-preserving checkout.
*.pdf binary
*.pptx binary
