{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaClima WebGIS records",
  "contract_version": "1.0.0",
  "$defs": {
    "observations": {
      "type": "object",
      "required": [
        "pivot_id",
        "date",
        "month",
        "scene_id",
        "status",
        "ndvi_median",
        "ndmi_median"
      ],
      "properties": {
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "scene_id": {
          "type": "string"
        },
        "status": {
          "const": "ok"
        },
        "ndvi_median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1,
          "x-unit": "dimensionless"
        },
        "ndmi_median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1,
          "x-unit": "dimensionless"
        },
        "valid_pixel_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "x-unit": "percent"
        },
        "processing_baseline": {
          "type": "string",
          "pattern": "^\\d{2}\\.\\d{2}$"
        },
        "provider": {
          "type": "string"
        },
        "collection": {
          "type": "string"
        },
        "native_scene_id": {
          "type": "string"
        },
        "acquisition_key": {
          "type": "string"
        },
        "radiometric_method": {
          "type": "string"
        },
        "calibration_path": {
          "type": "string"
        },
        "calibration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sentinel_source": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "pivot_id",
        "date",
        "scene_id"
      ],
      "description": "Accepted scene-level index medians over one pivot. Processing baseline is a version string, not a decimal number."
    },
    "monthly": {
      "type": "object",
      "required": [
        "pivot_id",
        "month",
        "monthly_status",
        "batch_status",
        "query_complete",
        "n_accepted_scenes",
        "ndvi_median",
        "ndmi_median"
      ],
      "properties": {
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "monthly_status": {
          "type": "string"
        },
        "batch_status": {
          "type": "string"
        },
        "query_complete": {
          "type": "boolean"
        },
        "n_accepted_scenes": {
          "type": "integer",
          "minimum": 0
        },
        "ndvi_median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1,
          "x-unit": "dimensionless"
        },
        "ndmi_median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1,
          "x-unit": "dimensionless"
        },
        "temporal_aggregation": {
          "const": "median_of_scene_medians_equal_weight"
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "pivot_id",
        "month"
      ],
      "description": "One pivot/month slot. Indices aggregate accepted scene medians with equal scene weights."
    },
    "precipitation": {
      "type": "object",
      "required": [
        "pivot_id",
        "month",
        "precip_mm",
        "precip_status"
      ],
      "properties": {
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "precip_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "x-unit": "mm/month"
        },
        "precip_status": {
          "type": "string"
        },
        "chirps_source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "pivot_id",
        "month"
      ],
      "description": "Regional CHIRPS monthly precipitation context. Nearby pivots may share one grid cell."
    },
    "quality": {
      "type": "object",
      "required": [
        "pivot_id",
        "month",
        "monthly_status",
        "batch_status",
        "query_complete",
        "n_attempted_scenes",
        "n_accepted_scenes",
        "quality_review"
      ],
      "properties": {
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "query_complete": {
          "type": "boolean"
        },
        "quality_review": {
          "type": "boolean"
        },
        "valid_pixel_pct_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "x-unit": "percent"
        },
        "valid_pixel_pct_median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "x-unit": "percent"
        },
        "n_accepted_scenes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "pivot_id",
        "month"
      ],
      "description": "Acquisition and observation coverage. Quality review uses zero accepted scenes or minimum valid area below 80%."
    },
    "models": {
      "type": "object",
      "required": [
        "experiment",
        "pivot_id",
        "target",
        "method",
        "phase",
        "status",
        "n_valid_pairs",
        "expected_months",
        "coverage_fraction",
        "mae",
        "rmse",
        "bias_mean"
      ],
      "properties": {
        "experiment": {
          "type": "string"
        },
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "ndvi_median",
            "ndmi_median"
          ]
        },
        "method": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "n_valid_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "expected_months": {
          "type": "integer",
          "minimum": 1
        },
        "coverage_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mae": {
          "type": [
            "number",
            "null"
          ]
        },
        "rmse": {
          "type": [
            "number",
            "null"
          ]
        },
        "bias_mean": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "experiment",
        "pivot_id",
        "target",
        "method",
        "phase"
      ],
      "description": "Separate numerical experiment summaries. Missing metrics remain null with their evidence status."
    },
    "model_predictions": {
      "type": "object",
      "required": [
        "experiment",
        "pivot_id",
        "target",
        "method",
        "phase",
        "month",
        "reference_month",
        "observed",
        "predicted",
        "residual",
        "status"
      ],
      "properties": {
        "experiment": {
          "type": "string"
        },
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "ndvi_median",
            "ndmi_median"
          ]
        },
        "method": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "reference_month": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "observed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1,
          "x-unit": "dimensionless"
        },
        "predicted": {
          "type": [
            "number",
            "null"
          ]
        },
        "residual": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "experiment",
        "pivot_id",
        "target",
        "method",
        "phase",
        "month"
      ],
      "description": "Per-month predictions, including missing targets and insufficient-training statuses. Residual is observed minus predicted."
    },
    "events": {
      "type": "object",
      "required": [
        "pivot_id",
        "index",
        "from_month",
        "to_month",
        "from_value",
        "to_value",
        "change",
        "absolute_change_threshold",
        "elapsed_calendar_months",
        "unobserved_months_between",
        "consecutive_calendar_months",
        "event_type"
      ],
      "properties": {
        "pivot_id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "enum": [
            "ndvi_median",
            "ndmi_median"
          ]
        },
        "from_month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "to_month": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "event_type": {
          "const": "descriptive_spectral_change"
        },
        "change": {
          "type": [
            "number",
            "null"
          ]
        },
        "consecutive_calendar_months": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "x-primary-key": [
        "pivot_id",
        "index",
        "from_month",
        "to_month"
      ],
      "description": "Threshold crossings between successive observed months, with calendar gaps explicitly retained."
    },
    "pivots": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "properties": {
                "type": "object",
                "required": [
                  "pivot_id",
                  "area_ha"
                ],
                "properties": {
                  "pivot_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "area_ha": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "x-unit": "ha"
                  }
                }
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  },
                  "coordinates": {
                    "type": "array"
                  }
                }
              }
            }
          }
        }
      },
      "description": "RFC7946 GeoJSON in WGS84 longitude/latitude. Original ANA attributes retained."
    }
  },
  "x-csv-decoding": {
    "encoding": "UTF-8",
    "delimiter": ",",
    "missing": "empty field becomes null",
    "booleans": [
      "true",
      "false"
    ],
    "identifiers": "Keep pivot_id as text, including leading zeroes",
    "typed-decoding": "Decode CSV columns using the corresponding record schema before JSON validation"
  }
}
